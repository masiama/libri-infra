// Loaded on every host: host and container metrics.

prometheus.remote_write "cloud" {
  // Every series gets a host label, so one dashboard can compare hosts
  external_labels = { host = sys.env("ALLOY_HOST") }

  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

// Host CPU, memory, disk, network (node_exporter), read from the host's mounts
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "60s"
  scrape_timeout  = "30s"
  forward_to      = [prometheus.remote_write.cloud.receiver]
}

// CPU and memory per container
prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  storage_duration = "5m"
  enabled_metrics = ["cpu", "memory", "network", "diskIO"]
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  scrape_interval = "60s"
  scrape_timeout  = "30s"
  forward_to      = [prometheus.relabel.containers.receiver]
}

// cAdvisor exports hundreds of series per container; keep only what the dashboard uses
prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|spec_memory_limit_bytes|network_(receive|transmit)_bytes_total|fs_(reads|writes)_bytes_total)"
    action        = "keep"
  }
}
